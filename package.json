{
  "name": "klal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env.local --watch server/index.js",
    "dev:web": "vite",
    "seed": "node --env-file-if-exists=.env.local server/seed.js",
    "build": "vite build && node scripts/emit-shell.mjs && node scripts/stamp-build.mjs && node scripts/check-csp.mjs && node scripts/check-no-dev-code.mjs",
    "start": "node server/index.js",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "node src/lib/shabbosState.test.mjs && node src/lib/search.test.mjs && node src/lib/minyanim.test.mjs && KC_STORE=memory node server/geocode.test.mjs && KC_STORE=memory node server/translate.test.mjs && node server/no-dev-code.test.mjs && KC_STORE=memory node server/video.test.mjs && node server/api.test.mjs",
    "create-admin": "node --env-file-if-exists=.env.local server/create-admin.js",
    "migrate": "node --env-file-if-exists=.env.local server/migrate.js",
    "test:gate": "node scripts/shabbos-gate-check.mjs ${KC_TEST_EMAIL:-} ${KC_TEST_PASSWORD:-}",
    "test:offline": "node scripts/sw-offline-check.mjs ${KC_TEST_EMAIL:-} ${KC_TEST_PASSWORD:-}",
    "test:hydration": "node scripts/hydration-check.mjs ${KC_BASE_URL:-https://klalconnect.org}",
    "test:home": "node scripts/home-check.mjs ${KC_BASE_URL:-http://localhost:5200}",
    "test:search": "node scripts/search-check.mjs ${KC_BASE_URL:-https://klalconnect.org}",
    "test:privacy": "node scripts/privacy-check.mjs ${KC_BASE_URL:-https://klalconnect.org}",
    "test:insights": "node scripts/insights-check.mjs ${KC_BASE_URL:-http://localhost:5200}",
    "test:ask-loop": "node scripts/ask-loop-check.mjs ${KC_BASE_URL:-http://localhost:5200}",
    "test:messages-scale": "node scripts/messages-scale-check.mjs ${KC_BASE_URL:-http://localhost:5200}",
    "test:a11y": "node scripts/a11y-check.mjs ${KC_BASE_URL:-http://localhost:5200}",
    "test:overflow": "node scripts/overflow-check.mjs ${KC_BASE_URL:-http://localhost:5200}",
    "test:contrast": "node scripts/contrast-check.mjs ${KC_BASE_URL:-http://localhost:5200}",
    "clear-demo": "node server/clear-demo.js",
    "import-blob": "node --env-file-if-exists=.env.local server/import-blob.js",
    "test:critical-paths": "node scripts/critical-paths-check.mjs ${KC_BASE_URL:-http://localhost:5200}",
    "test:safe-area": "node scripts/safe-area-check.mjs ${KC_BASE_URL:-http://localhost:5200}",
    "ensure-categories": "node --env-file-if-exists=.env.local server/ensure-categories.js",
    "rename-invite": "node --env-file-if-exists=.env.local server/rename-invite.js",
    "deploy:status": "node scripts/deploy-status.mjs",
    "ship": "node scripts/preflight-ship.mjs && npm run lint && npm test && npm run build && vercel --prod --yes && npm run deploy:status",
    "test:categories": "node scripts/categories-check.mjs",
    "prod:admin": "node scripts/prod-admin.mjs",
    "add-publisher": "node scripts/add-publisher.mjs",
    "set-deploy-token": "node scripts/set-deploy-token.mjs --deploy"
  },
  "dependencies": {
    "@hebcal/core": "^6.9.2",
